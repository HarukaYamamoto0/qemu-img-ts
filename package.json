{
	"name": "qemu-img-ts",
	"version": "1.0.0",
	"private": false,
	"description": "A TypeScript wrapper for the qemu-img command-line utility, enabling programmatic disk image creation, conversion, inspection, and management.",
	"main": "dist/index.js",
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"prepublishOnly": "bun run build",
		"build": "bunx tsc",
		"lint": "bunx eslint . --ext .ts --cache --cache-strategy content",
		"lint:fix": "bunx eslint . --ext .ts --fix --cache --cache-strategy content",
		"format": "bunx prettier --check . --cache --cache-strategy content",
		"format:fix": "bunx prettier --write . --cache --cache-strategy content",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/bun": "^1.4.3",
		"@types/node": "^26.6.5",
		"eslint": "^10.6.0",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^17.13.0",
		"prettier": "^3.9.10",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.62.1"
	},
	"author": {
		"name": "HarukaYamamoto0",
		"email": "harukayamamotodev@gmail.com",
		"url": "https://harukadev.com"
	},
	"license": "MIT",
	"engines": {
		"bun": "^1.3.14"
	}
}
