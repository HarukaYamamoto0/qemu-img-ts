{
	"name": "qemu-img-ts",
	"version": "0.1.2",
	"description": "A TypeScript wrapper for the qemu-img command-line utility, enabling programmatic disk image creation, conversion, inspection, and management.",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"prepublishOnly": "bun run build",
		"typecheck": "tsc --noEmit",
		"build": "bun run typecheck && bun run tsc && bun run tsc-alias",
		"test": "bun test",
		"lint": "bunx eslint . --ext .ts --cache --cache-strategy content",
		"lint:fix": "bunx eslint . --ext .ts --fix --cache --cache-strategy content",
		"format": "bunx prettier --check . --cache --cache-strategy content",
		"format:fix": "bunx prettier --write . --cache --cache-strategy content"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/HarukaYamamoto0/qemu-img-ts.git"
	},
	"bugs": {
		"url": "https://github.com/HarukaYamamoto0/qemu-img-ts/issues"
	},
	"homepage": "https://github.com/HarukaYamamoto0/qemu-img-ts#readme",
	"keywords": [
		"qemu",
		"qemu-img",
		"virtualization",
		"disk-image",
		"qcow2",
		"raw",
		"typescript"
	],
	"author": {
		"name": "HarukaYamamoto0",
		"email": "harukayamamotodev@gmail.com",
		"url": "https://harukadev.com"
	},
	"license": "MIT",
	"engines": {
		"bun": ">=1.3.14"
	},
	"packageManager": "bun@1.4.4",
	"sideEffects": false,
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/bun": "^1.4.4",
		"@types/node": "^26.6.6",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^17.14.0",
		"prettier": "^3.9.10",
		"tsc-alias": "^1.9.10",
		"typescript": "^7.0.2",
		"typescript-eslint": "^8.72.1"
	}
}
